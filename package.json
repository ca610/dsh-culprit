{
  "name": "dsh-culprit",
  "version": "0.1.0",
  "private": true,
  "description": "Regression culprit finder: bisect a failing predicate to the exact commit that broke it, with evidence.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git-bisect",
    "regression",
    "debugging"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ca610/dsh-culprit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ca610/dsh-culprit.git"
  },
  "bugs": {
    "url": "https://github.com/ca610/dsh-culprit/issues"
  },
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/culprit.test.mjs",
    "test:host": "node test/host-dispatch.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
